# Single authority for every pinned toolchain version in this workspace.
#
# Sourced through `load_toolchain` in tools/lib/shell.sh by:
#   .devcontainer/setup.sh, .devcontainer/smoke-test.sh,
#   .sandbox/launch-pi.sh, .sandbox/bootstrap-pi.sh,
#   .sandbox/smoke-test.sh, .sandbox/test-contract.sh
#
# Bump a version here and nowhere else. Every consumer derives its assertions
# from these values, so a bump that the environment cannot satisfy fails closed
# at the first assertion rather than silently downgrading.

EXPECTED_NODE='v24.19.0'
EXPECTED_PNPM='11.20.0'
EXPECTED_PYTHON='Python 3.14.4'
EXPECTED_UV='uv 0.12.2'

# Pi coding agent. `load_toolchain` validates the shape and derives
# EXPECTED_PI from the trailing version.
PI_PACKAGE='@earendil-works/pi-coding-agent@0.84.1'

# Docker Sandboxes CLI. SBX_MINIMUM is enforced; SBX_VERIFIED records the
# version the committed lifecycle forms were validated against. Anything above
# SBX_VERIFIED runs with a warning rather than failing closed.
SBX_MINIMUM='0.38.0'
SBX_VERIFIED='0.38.0'
