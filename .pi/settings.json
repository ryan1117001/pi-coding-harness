{
  "packages": [
    "npm:pi-web-access",
    "npm:pi-readseek",
    "npm:pi-lens",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-intercom",
    "npm:@gotgenes/pi-permission-system",
    "npm:@narumitw/pi-retry"
  ],
  "readseek": {
    "replacedTools": ["read", "edit", "write", "grep"],
    "imageMode": "auto",
    "syntaxValidation": "warn",
    "timeoutMs": 240000,
    "grep": {
      "maxLines": 2000,
      "maxBytes": 51200
    }
  }
}
